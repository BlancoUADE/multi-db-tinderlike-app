# Base de Datos - PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=tinder_app
PG_USER=tpo_user
PG_PASSWORD=tpo_password

# Base de Datos - MongoDB
MONGO_URI=mongodb://tpo_user:tpo_password@localhost:27017/
MONGO_DB=tinder_app

# Base de Datos - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Base de Datos - Cassandra
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=tinder_app

# Base de Datos - Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tpo_password
